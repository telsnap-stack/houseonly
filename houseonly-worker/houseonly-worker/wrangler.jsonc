{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "houseonly-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "houseonly-audio"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "WISHLIST",
      "id": "cc7a1301f8b146768e4c2604c6b3d563"
    },
    {
      "binding": "SYNC_STATE",
      "id": "5c5c0ee16cc34f68bd2109b01894f09d"
    },
    // Emails de distribuidor archivados por el Apps Script. Compartido entre
    // prod y staging a proposito (como WISHLIST): el archivo es el mismo, no
    // tiene sentido duplicarlo, y solo se escribe desde el Apps Script.
    {
      "binding": "EMAILS",
      "id": "e4966f4a96e84c578bfd96b1d12bdf63"
    }
  ],
  // Cron triggers. Production cron activated May 19 2026 when Fase 3 was migrated
  // to prod. Polls Discogs marketplace every 15 min to detect sales (Fase 3E).
  // Staging cron continues to run independently (see env.staging.triggers below).
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "env": {
    "staging": {
      "name": "houseonly-worker-staging",
      "observability": {
        "enabled": true
      },
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "houseonly-audio"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "WISHLIST",
          "id": "cc7a1301f8b146768e4c2604c6b3d563"
        },
        {
          "binding": "SYNC_STATE",
          "id": "5069be832df64efdb5e3d1a49f85b0ea"
        },
        {
          "binding": "EMAILS",
          "id": "e4966f4a96e84c578bfd96b1d12bdf63"
        }
      ],
      // NO cron on staging (2026-09-02). It polled Discogs every 15 min in dry
      // mode — creating nothing — while spending requests from the SAME 60/min
      // Discogs budget prod needs, at the same instant prod polls. With an
      // external consumer already saturating that budget, staging was pure
      // competition for it.
      //
      // MUST be an explicit empty list, not a deleted block: `triggers` is an
      // inheritable key, so omitting it makes staging inherit the top-level
      // */15 rather than have no cron.
      //
      // Nothing depended on it. The staging worker itself stays — six scripts
      // POST to its fetch endpoints (webhook registration/tests, backfills) —
      // and graduation can still be driven by hand via ?action=graduation-run.
      "triggers": {
        "crons": []
      }
    }
  }
}
